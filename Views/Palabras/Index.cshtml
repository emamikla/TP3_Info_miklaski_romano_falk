@{
    ViewData["Title"] = "Home Page";
}

<main>
        <h1>EL AHORCADO</h1>
        <h3>Bienvenido al ahorcado! Debes adivinar la palabra con un máximo de 10 intentos.</h3>
        <section>
        <div>
            <h4>La palabra es:</h4>
            <div id = "guionPalabra">
            </div>

            <div id = "intentosRestantes">
            </div>
        </div>
        <div>
            <input type="text" id= "letra" maxLength ="1" placeholder="Ingresa la letra"><br><br>
            <button onclick = "ArriesgarLetra()">PROBAR</button>
            <form method="post" action = '@Url.Action("AgregarPalabra", "Palabras" , new{palabra = ""})'>
                <input type="text" name="palabra" placeholder="Agregar palabra">
                <button type="submit">AGREGAR</button>
            </form>
        </div>
        <input type ="hidden" id="palabra" value="@ViewBag.palabra">
        </section>
        <section> 
            <h3>Letras que no están: </h3>
            <div id = "letrasFaltantes">
            </div>
        </section>
    <section>
        <div id= "resultado">
        </div>
    </section>
</main>

